# Copy to .env and fill in ONE provider's key.
# .env is gitignored; .env.example is committed.

TRAINER_ENABLED=1

# anthropic | openai
TRAINER_PROVIDER=anthropic
TRAINER_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For openai instead:
#   TRAINER_PROVIDER=openai
#   TRAINER_MODEL=gpt-4o
